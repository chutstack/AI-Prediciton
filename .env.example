# Application
SECRET_KEY=your-super-secret-key-change-this-in-production

# Database
DATABASE_URL=sqlite:///./predictions.db

# ── The Odds API ────────────────────────────────────────────────────────────
# Sign up at https://the-odds-api.com — free tier: 500 req/month
# Used to fetch real bookmaker odds for value bet scanning
THE_ODDS_API_KEY=your_odds_api_key

# ── Telegram Bot ────────────────────────────────────────────────────────────
# Create bot via @BotFather on Telegram
# Free channel = teasers, paid channel (via Whop.com) = full picks
TELEGRAM_BOT_TOKEN=7123456789:AAHxxxxxxxxxx
TELEGRAM_CHANNEL_ID=@yourchannel

# ── Binance (optional — for crypto signal auto-execution) ───────────────────
# Restrict to "trade only" — NO withdrawal permissions
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── Whop.com (optional — for managing paid community access) ───────────────
# Sign up at https://whop.com to list your picks service
WHOP_API_KEY=
